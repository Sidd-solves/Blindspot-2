{
 "name": "blindspot",
 "private": true,
 "version": "0.1.0",
 "type": "module",
 "workspaces": [
  "packages/*",
  "services/*",
  "apps/*"
 ],
 "scripts": {
  "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @blindspot/api\" \"npm run dev -w @blindspot/web\"",
  "api": "npm run dev -w @blindspot/api",
  "web": "npm run dev -w @blindspot/web",
  "mcp": "npm run start -w @blindspot/mcp-server",
  "test": "vitest run",
  "typecheck": "tsc --noEmit -p tsconfig.json",
  "format": "prettier --write \"{apps/web/src,services/*/src,packages/*/src,tests,e2e}/**/*.{ts,tsx}\"",
  "format:check": "prettier --check \"{apps/web/src,services/*/src,packages/*/src,tests,e2e}/**/*.{ts,tsx}\"",
  "lint": "eslint apps/web/src services/api/src services/mcp-server/src packages/analytics/src packages/tool-contracts/src tests e2e",
  "coverage": "vitest run --coverage",
  "bench": "tsx scripts/bench.ts",
  "e2e": "playwright test"
 },
 "devDependencies": {
  "@playwright/test": "^1.49.1",
  "@types/node": "^22.0.0",
  "@vitest/coverage-v8": "^5.0.5",
  "concurrently": "^9.0.0",
  "eslint": "^9.39.5",
  "eslint-plugin-react-hooks": "^5.2.0",
  "prettier": "^3.9.10",
  "tsx": "^4.19.0",
  "typescript": "^5.6.0",
  "typescript-eslint": "^8.72.1",
  "vitest": "^5.0.5"
 }
}
