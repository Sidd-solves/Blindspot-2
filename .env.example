# --- Server (services/api) -----------------------------------------------
PORT=8787
# HOST defaults to 127.0.0.1 in dev, 0.0.0.0 when NODE_ENV=production
# NODE_ENV=production
# Comma-separated browser origins allowed to call the API and open the bridge
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8765,http://localhost:8765

# --- Security --------------------------------------------------------------
# Shared secret every WebSocket bridge client (extension, MCP server) must send. REQUIRED in production.
BRIDGE_TOKEN=
# Bearer token for Tableau-touching tools (get-worksheet-data, set-parameter, get-dashboard-screenshot).
# In production these tools are disabled until this is set.
ADMIN_TOKEN=

# --- AI (optional) -----------------------------------------------------------
# Without a key, the analyst runs in deterministic mode (all numbers still real).
ANTHROPIC_API_KEY=
# claude-haiku-4-5 | claude-sonnet-5-5 (default) | claude-opus-5-5. Also switchable in Settings.
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Tableau REST (optional, for get-dashboard-screenshot) ---------------------
TABLEAU_SERVER_URL=
TABLEAU_SITE=
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=

# --- MCP server (services/mcp-server) ------------------------------------------
# Relay Tableau calls through a running API's bridge
BRIDGE_URL=ws://127.0.0.1:8787/bridge
# Optional: analyse a CSV instead of the synthetic sample
# BLINDSPOT_CSV=/absolute/path/to/data.csv
